<Window x:Class="Pet_Shop_Cart.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pet_Shop_Cart"
        mc:Ignorable="d"
        Title="Giỏ Hàng" Height="700" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- Converters -->
        <local:BoolToGradientConverter x:Key="BoolToGradientConverter"/>
        <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Gradient Brush -->
        <LinearGradientBrush x:Key="GradientBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#FFC476" Offset="0"/>
            <GradientStop Color="#FFA2A2" Offset="1"/>
        </LinearGradientBrush>

        <!-- Button Style for Navigation -->
        <!-- Button Style for Navigation -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Margin" Value="0,8,0,8"/>
            <Setter Property="Background" Value="#33FFFFFF"/>
            <!-- mặc định mờ -->
            <Setter Property="Foreground" Value="White"/>
            <!-- icon trắng -->
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="20"
                                BorderThickness="0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

            <!-- 🩵 Hiệu ứng hover -->
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#4DFFFFFF"/>
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.15" ScaleY="1.15"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>

                <!-- 🧡 Khi Tag="Active" => đảo màu -->
                <Trigger Property="Tag" Value="Active">
                    <Setter Property="Background" Value="White"/>
                    <Setter Property="Foreground" Value="#FF8A65"/>
                    <!-- cam, icon đổi màu -->
                </Trigger>

            </Style.Triggers>
        </Style>


        <!-- Round Button Style -->
        <Style x:Key="RoundButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FFA2A2"/>
                    <Setter Property="Background" Value="{StaticResource GradientBrush}"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quantity Button Style -->
        <Style x:Key="QtyButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Background" Value="{StaticResource GradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="1.1" ScaleY="1.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Order Button Style -->
        <Style x:Key="OrderButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GradientBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#FFA2A2" BlurRadius="15" ShadowDepth="3" Opacity="0.6"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="60"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource GradientBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
            </Border.Effect>

            <StackPanel>
                <!-- Logo -->
                <Image Source="K:\Visual Programming Projects\Pet-Shop-Project\Pet_Shop_Cart\peach.png" Width="41" Height="49" Margin="0,15,0,20"/>

                <!-- Back Button -->
                <Button Style="{StaticResource NavButtonStyle}" 
                        ToolTip="Quay lại"
                        Click="BackButton_Click"
                        Margin="10,0,10,15">
                    <Path Data="M10 9l-6 6 6 6 M20 4v7a4 4 0 0 1-4 4H5"
                          Stroke="White"
                          StrokeThickness="2"
                          Stretch="Uniform"
                          Width="20"
                          Height="20"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
                </Button>


                <!-- Home Icon -->
                <Button Style="{StaticResource NavButtonStyle}" 
                        Margin="10,8,10,8"
                        ToolTip="Trang chủ">
                    <Path Data="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10" 
                          Stroke="White" 
                          StrokeThickness="2" 
                          Stretch="Uniform"
                          Width="20" Height="20"/>
                </Button>

                <!-- Cart Icon -->
                <Button Style="{StaticResource NavButtonStyle}"
                        Margin="10,8,10,8"
                        ToolTip="Giỏ hàng"
                        Tag="Active">
                    <Path Data="M9 21a1 1 0 100-2 1 1 0 000 2zm11 0a1 1 0 100-2 1 1 0 000 2zM1 1h4l2.68 13.39a2 2 0 002 1.61h9.72a2 2 0 002-1.61L23 6H6"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2"
                          Stretch="Uniform"
                          Width="20" Height="20"/>
                </Button>


                <!-- Orders Icon -->
                <Button Style="{StaticResource NavButtonStyle}" 
                        Margin="10,8,10,8"
                        ToolTip="Đơn hàng">
                    <Path Data="M21 16V8a2 2 0 00-1-1.73l-7-4a2 2 0 00-2 0l-7 4A2 2 0 003 8v8a2 2 0 001 1.73l7 4a2 2 0 002 0l7-4A2 2 0 0021 16zM3.27 6.96L12 12.01l8.73-5.05M12 22.08V12" 
                          Stroke="White" 
                          StrokeThickness="2" 
                          Stretch="Uniform"
                          Width="20" Height="20"/>
                </Button>

                <!-- Account Avatar (Bottom) -->
                <Button Style="{StaticResource NavButtonStyle}" 
                        Margin="10,280,10,8"
                        ToolTip="Tài khoản"
                        Padding="0">
                    <Border CornerRadius="20" Width="40" Height="40">
                        <Border.Background>
                            <ImageBrush ImageSource="https://ui-avatars.com/api/?name=User&amp;background=ffa2a2&amp;color=fff" 
                                        Stretch="UniformToFill"
                                        AlignmentX="Center"
                                        AlignmentY="Center"/>
                        </Border.Background>
                    </Border>
                </Button>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Column="1" Background="White" Margin="0,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="30,30,30,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Giỏ hàng" 
                           FontSize="32" 
                           FontWeight="SemiBold"
                           Foreground="#333333"
                           VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource RoundButtonStyle}" 
                            Content="✓" 
                            FontSize="16"
                            Margin="0,0,10,0"
                            ToolTip="Chọn tất cả"
                            Click="SelectAll_Click"/>
                    <Button Style="{StaticResource RoundButtonStyle}" 
                            Content="×" 
                            FontSize="20"
                            FontWeight="Bold"
                            ToolTip="Xóa đã chọn"
                            Click="DeleteSelected_Click"/>
                </StackPanel>
            </Grid>

            <!-- Cart Items ScrollViewer -->
            <ScrollViewer Grid.Row="1" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="30,0,30,20">
                <ItemsControl x:Name="CartItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="White" 
                                    BorderBrush="#E0E0E0" 
                                    BorderThickness="2"
                                    CornerRadius="12"
                                    Padding="15"
                                    Margin="0,0,0,15">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Checkbox -->

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Center"
                                              Margin="0,0,15,0"
                                              Cursor="Hand">
                                        <CheckBox.Style>
                                            <Style TargetType="CheckBox">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="CheckBox">
                                                            <Border Width="24" Height="24"
                                                                    CornerRadius="12"
                                                                    BorderThickness="2"
                                                                    BorderBrush="#DDDDDD"
                                                                    Background="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToGradientConverter}}">
                                                                <TextBlock Text="✓"
                                                                           Foreground="White"
                                                                           FontSize="14"
                                                                           FontWeight="Bold"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding IsChecked, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource BoolToVisibilityConverter}}"/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </CheckBox.Style>
                                    </CheckBox>

                                    <!-- Product Image -->
                                    <Border Grid.Column="1" 
                                            Width="80" Height="80"
                                            CornerRadius="8"
                                            Background="#F0F0F0"
                                            Margin="0,0,15,0">
                                        <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
                                    </Border>

                                    <!-- Product Details -->
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" 
                                                   FontSize="16" 
                                                   FontWeight="SemiBold"
                                                   Foreground="#333333"
                                                   Margin="0,0,0,6"/>

                                        <Border Background="#F5F5F5"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="10,4"
                                                HorizontalAlignment="Left"
                                                Margin="0,0,0,6"
                                                Cursor="Hand">
                                            <TextBlock Text="{Binding Variant}" 
                                                       FontSize="13"
                                                       Foreground="#666666"/>
                                        </Border>

                                        <TextBlock Text="{Binding Price, StringFormat={}{0:N0}đ}" 
                                                   FontSize="16" 
                                                   FontWeight="Medium"
                                                   Foreground="#FF6B6B"
                                                   Margin="0,0,0,10"/>

                                        <!-- Quantity Control -->
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource QtyButtonStyle}" 
                                                    Content="−"
                                                    Click="DecreaseQty_Click"
                                                    Tag="{Binding}"/>
                                            <TextBlock Text="{Binding Quantity}" 
                                                       FontWeight="SemiBold"
                                                       Margin="15,0"
                                                       VerticalAlignment="Center"
                                                       MinWidth="30"
                                                       TextAlignment="Center"/>
                                            <Button Style="{StaticResource QtyButtonStyle}" 
                                                    Content="+"
                                                    Click="IncreaseQty_Click"
                                                    Tag="{Binding}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Delete Button -->
                                    <Button Grid.Column="3"
                                            Width="36" Height="36"
                                            Background="#FFE0E0"
                                            BorderThickness="0"
                                            Cursor="Hand"
                                            VerticalAlignment="Top"
                                            Click="DeleteItem_Click"
                                            Tag="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}" CornerRadius="18">
                                                    <TextBlock Text="×" 
                                                               Foreground="#FF6B6B" 
                                                               FontSize="24"
                                                               FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <Button.Style>
                                            <Style TargetType="Button">
                                                <Setter Property="Background" Value="#FFE0E0"/>
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#FF6B6B"/>
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>
                            </Border>
                            
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- Floating Summary Box (Bottom Right) -->
        <Border Grid.Column="1"
                Background="White"
                CornerRadius="12"
                Padding="20,15"
                Margin="0,0,20,20"
                MinWidth="280"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.2"/>
            </Border.Effect>

            <StackPanel>
                <!-- Total Items -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Tổng" 
                               Foreground="#666666" 
                               FontSize="14"/>
                    <TextBlock Grid.Column="1"
                               x:Name="TotalItemsText"
                               Text="0 sản phẩm" 
                               FontWeight="SemiBold"
                               FontSize="14"
                               Foreground="#333333"/>
                </Grid>

                <!-- Total Price -->
                <Border BorderBrush="#E0E0E0" 
                        BorderThickness="0,1,0,0" 
                        Padding="0,10,0,0"
                        Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Thành tiền" 
                                   Foreground="#666666" 
                                   FontSize="16"/>
                        <TextBlock Grid.Column="1"
                                   x:Name="TotalPriceText"
                                   Text="0đ" 
                                   FontWeight="SemiBold"
                                   FontSize="18"
                                   Foreground="#FF6B6B"/>
                    </Grid>
                </Border>

                <!-- Order Button -->
                <Button Style="{StaticResource OrderButtonStyle}"
                        Content="Mua hàng"
                        Click="PlaceOrder_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>